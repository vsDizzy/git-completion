<Project Sdk="WixToolset.Sdk/7.0.0">

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>GitCompletion</OutputName>
    <AcceptEula>wix7</AcceptEula>

    <!-- The version is owned by Changesets and lives in package.json. -->
    <PackageJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\package.json'))</PackageJson>
    <ProductVersion>$([System.Text.RegularExpressions.Regex]::Match($(PackageJson), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>

    <SuppressIces>ICE61;ICE91</SuppressIces>
  </PropertyGroup>

</Project>