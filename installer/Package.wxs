<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="GitCompletion"
    Version="$(var.ProductVersion)"
    Manufacturer="vsDizzy"
    UpgradeCode="DA7C9758-BA8C-CE46-CF91-5C7913F2F124"
    Scope="perUser">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade
      DowngradeErrorMessage="A later version of [ProductName] is already installed."
      AllowSameVersionUpgrades="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="VsDizzyFolder" Name="vsDizzy">

        <Directory Id="INSTALLFOLDER" Name="GitCompletion">
          <Component
            Id="MainModule"
            Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

            <CreateFolder />

            <RegistryValue
              Root="HKCU"
              Key="Software\vsDizzy\GitCompletion"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />

            <File Id="GitCompletionPsd1" Source="../src/GitCompletion.psd1" />
            <File Id="GitCompletionPsm1" Source="../src/GitCompletion.psm1" />

            <RemoveFolder
              Id="RemoveInstallFolder"
              On="uninstall" />

          </Component>
        </Directory>

        <Directory Id="SETUPFOLDER" Name="GitCompletionSetup">
          <Component
            Id="InstallerScripts"
            Guid="6F1D7B5A-8B7F-4D67-9A48-2C1D5F9E3A71">

            <RegistryValue
              Root="HKCU"
              Key="Software\vsDizzy\GitCompletion"
              Name="InstallerScripts"
              Type="integer"
              Value="1"
              KeyPath="yes" />

            <File
              Id="BootstrapPs1"
              Source="../setup/Bootstrap.ps1" />

            <File
              Id="SetupPs1"
              Source="../setup/Setup.ps1" />

            <RemoveFolder
              Id="RemoveSetupFolder"
              On="uninstall" />

          </Component>
        </Directory>

        <Component
          Id="VsDizzyFolderCleanup"
          Guid="C3D4E5F6-A789-0123-CDEF-123456789012">

          <CreateFolder Directory="VsDizzyFolder" />

          <RegistryValue
            Root="HKCU"
            Key="Software\vsDizzy\GitCompletion"
            Name="VsDizzyFolderCleanup"
            Type="integer"
            Value="1"
            KeyPath="yes" />

          <RemoveFolder
            Id="RemoveVsDizzyFolder"
            Directory="VsDizzyFolder"
            On="uninstall" />

        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Deferred install/repair action. -->
    <SetProperty
      Id="RunBootstrapInstall"
      Value="&quot;powershell.exe&quot; -ExecutionPolicy Bypass -NonInteractive -NoProfile -File &quot;[#BootstrapPs1]&quot;"
      Before="RunBootstrapInstall"
      Sequence="execute"
      Condition="NOT REMOVE=&quot;ALL&quot;" />

    <CustomAction
      Id="RunBootstrapInstall"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <!-- Rollback install state. -->
    <SetProperty
      Id="RollbackBootstrapInstall"
      Value="&quot;powershell.exe&quot; -ExecutionPolicy Bypass -NonInteractive -NoProfile -File &quot;[#BootstrapPs1]&quot; -Uninstall"
      Before="RollbackBootstrapInstall"
      Sequence="execute"
      Condition="NOT Installed" />

    <CustomAction
      Id="RollbackBootstrapInstall"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="rollback"
      Impersonate="yes"
      Return="ignore" />

    <!-- Immediate uninstall action. -->
    <SetProperty
      Id="WixQuietExecCmdLine"
      Value="&quot;powershell.exe&quot; -ExecutionPolicy Bypass -NonInteractive -NoProfile -File &quot;[#BootstrapPs1]&quot; -Uninstall"
      Before="RunBootstrapUninstall"
      Sequence="execute"
      Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    <CustomAction
      Id="RunBootstrapUninstall"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>

      <Custom
        Action="RollbackBootstrapInstall"
        Before="RunBootstrapInstall"
        Condition="NOT Installed" />

      <!-- Install + Repair + new product during major upgrade. -->
      <Custom
        Action="RunBootstrapInstall"
        After="InstallFiles"
        Condition="NOT REMOVE=&quot;ALL&quot;" />

      <!-- Normal uninstall only. -->
      <Custom
        Action="RunBootstrapUninstall"
        Before="RemoveFiles"
        Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    </InstallExecuteSequence>

  </Package>
</Wix>